# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project → Project Settings → API (or Data API).
# The anon (public) key is meant to be public; row level security protects the data.
# Do NOT put the service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Seller's WhatsApp number that receives client selections.
# International format, e.g. +212612345678 (a Moroccan 06/07 number such as 0612345678 also works).
# Leave empty to show a "not configured" message instead of the WhatsApp button.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: the store name shown in the header and page titles.
# Defaults to a generic "Wholesale catalog" label.
NEXT_PUBLIC_STORE_NAME=
